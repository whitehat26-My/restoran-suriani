# Response headers for every asset served by the Worker.
#
# Cloudflare parses this file and applies the rules; it is never served itself.
# It MUST live at the root of the assets directory (public/), not the repo root.
#
# Matching is CUMULATIVE, not "most specific wins" — every matching block's
# headers are added. To replace a header set by a broader block you must first
# drop it with `! Header-Name`, otherwise the response carries both values.
#
# Limits: 100 rules, 2000 characters per line.
#
# HSTS is deliberately absent here. _headers only decorates static-asset
# responses, so it would miss the http->https redirect, the www->apex redirect
# and WAF block pages — and HSTS preload requires the header on the redirect
# chain. It is set once at the zone instead (scripts/cloudflare-setup.sh).

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-coKYngo/wc90klc4KeDfMmYqZNIx8aBpj4hBw6ErM0E='; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

# Photos are NOT immutable — assets/README.txt tells the owner to drop new
# photos in under the same names. 30 days with revalidation instead. If you
# ever replace a photo, rename it rather than overwriting.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Fonts are content-stable: the filenames only change when the subset changes.
# This block must come AFTER /assets/* — rules apply in file order, so placed
# before it, the broader rule's "! Cache-Control" erases this value and fonts
# silently get the 30-day photo policy instead. (Found by measuring, per the
# warning at the top of this file.)
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Photos must be fetchable cross-origin, otherwise the Open Graph card and the
# structured-data images fail to render in WhatsApp, Facebook and Google.
/assets/*.jpg
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

# menu-data.js is the file the restaurant edits to change prices, and no
# filename here is content-hashed. A long cache would strand returning
# visitors on stale prices, so keep it short and lean on revalidation.
/*.js
  ! Cache-Control
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/*.css
  ! Cache-Control
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Icons and the manifest change only when the brand does. A week is long
# enough to help repeat visits and short enough that a logo change reaches
# everyone quickly. These are listed one per block because a _headers rule
# takes a single path, and matched explicitly rather than by a /*.png glob,
# which would also catch the photos and override their 30-day policy.
/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=604800

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/icon-192.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/icon-512.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/site.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=604800

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600
